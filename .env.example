# Set DEBUG=1 for verbose logs (top movers, near-misses, whale checks)
DEBUG=0
# Telegram bot token from @BotFather. Leave empty to run console-only.
TELEGRAM_BOT_TOKEN=
# Poll interval in seconds (applies to both DEX and CEX)
POLL_INTERVAL=60
# Cooldown per token/pair between repeat alerts (minutes)
ALERT_COOLDOWN_MIN=30
# CEX exchanges to monitor (comma-separated). Remove any you don't want.
CEX_EXCHANGES=binance,mexc,bybit,gate,kucoin,bitget

# --- On-chain whale alerts (optional, free keys) ---
# EVM chains (ETH/BSC/Base/...): free key from https://etherscan.io/apis
ETHERSCAN_API_KEY=
# Solana: free key from https://helius.dev
HELIUS_API_KEY=
# Whale thresholds: alert when a single transfer exceeds
# min(WHALE_USD, WHALE_LIQ_PCT% of pair liquidity)
WHALE_USD=1000000
WHALE_LIQ_PCT=20
# Seconds between on-chain whale checks per token (protects free API quotas)
WHALE_INTERVAL=300
# Hours between 'I am alive' heartbeat messages (0 = off)
HEARTBEAT_HOURS=24
# Only send alerts at or above this severity to Telegram: LOW | MEDIUM | HIGH
ALERT_MIN_SEVERITY=LOW
# Whale alerts: liquidity-relative threshold never drops below this (USD)
WHALE_MIN_USD=50000
# Arkham Intel API key (optional): names the entities behind whale transfers.
# Sign up at https://arkm.com/api/docs or apply for their API pilot program.
ARKHAM_API_KEY=
# CoinMarketCal API key (optional, free, no card): enables TGE + token-unlock alerts.
# Sign up at https://coinmarketcal.com/en/developer
COINMARKETCAL_API_KEY=
# Moralis API key (optional, free, no card): whale coverage on BSC/Base/Arbitrum.
# Sign up at https://moralis.io
MORALIS_API_KEY=
# Solana whale checks: cheap RPC trigger every N sec (1 credit), full parse only on activity
WHALE_INTERVAL_SOL=300
# Safety-net full parse per Solana token regardless of trigger (seconds, default 6h)
WHALE_SOL_FULL=21600
# Funding-rate alert threshold (%/8h). 0.5 = only strong extremes. Lower for more alerts.
FUNDING_MIN_PCT=0.5
FUNDING_SEVERE_PCT=0.75
# CEX move thresholds (%). Pumps and sell-offs tuned independently.
PUMP_MIN_PCT=8
DUMP_MIN_PCT=20
BIG_MOVE_PCT=25
SLOW_MOVE_PCT=20
# Seconds between whale checks on Moralis-served chains (BSC/Base/Arbitrum).
# Free tier is 40K CU/day - 7200 (2h) keeps ~61 tokens inside budget.
WHALE_INTERVAL_EVM_ALT=7200
