PATCH 3 — test-delivery.js
INSERT the block below immediately BEFORE this existing line:

console.log('48. MECHANISM — a sourced date can name no discrete event; weak falsifiers are stated');

--- begin insert ---
console.log('55. a DEMOTE states its own scope — what it read, and what it could not distinguish');
{
  const { demoteScope } = await import('./src/sources/calendar/cadence-watch.js');
  // ENA demoted 2026-09-10 on a SINGLE-WALLET spec while carrying unwatched
  // co-emitters. Single-wallet was the deliberate choice (an irregular emitter would
  // false-demote every quiet month) — and the opposite failure then happened: the
  // verdict cannot tell a stopped schedule from a migration. Until this line existed
  // that caveat lived only in the operator's head, which is the quarantine-lapse
  // shape this project has fixed four times elsewhere.
  const single = { sym: 'ENA', cadence: { wallet: '0xw', meanAmount: 1 }, alsoObserve: ['0xa', '0xb'] };
  const s = demoteScope(single);
  check('single-wallet demote says it read ONE wallet', /SINGLE-WALLET spec/.test(s) && /one custody wallet was read/.test(s));
  check('it names how many co-emitters it did NOT watch, and why', /2 known co-emitters are deliberately UNWATCHED/.test(s) && /false-demote every quiet month/.test(s));
  check('it states the thing it CANNOT distinguish, not just what it saw', /CANNOT distinguish a stopped schedule from a migration/.test(s));
  check('it names the command that would settle it', /detect-cadence\.js ENA/.test(s));
  const family = { sym: 'EIGEN', cadence: { wallets: [{ addr: '0x1' }, { addr: '0x2' }] }, alsoObserve: ['0xc'] };
  const f = demoteScope(family);
  check('a FAMILY demote makes a different claim — the total failed, not one address', /FAMILY spec/.test(f) && /all 2 listed wallets were read/.test(f) && /not that one address went quiet/.test(f));
  check('family scope still discloses co-emitters outside the band', /1 irregular co-emitter is deliberately outside the band/.test(f));
  check('a row with no co-emitters does not invent any', !/co-emitter/.test(demoteScope({ sym: 'X', cadence: { wallet: '0xw' } })));
  check('the two scopes are not interchangeable text', s !== f);
  // LIVE: the row that actually demoted must be the single-wallet case.
  const live = JSON.parse(readFileSync('unlocks.json', 'utf8')).tokens.find((t) => t.sym === 'ENA');
  check('LIVE: ENA is a single-wallet spec carrying unwatched co-emitters', !Array.isArray(live?.cadence?.wallets) && (live?.alsoObserve || []).length >= 1);
  check('LIVE: its demote message would carry the migration caveat', /CANNOT distinguish/.test(demoteScope(live)));
}

--- end insert ---

