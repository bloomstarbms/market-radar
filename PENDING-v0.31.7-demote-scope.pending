PATCH 1 — src/sources/calendar/cadence-watch.js
INSERT the block below immediately BEFORE this existing line:

// Evidence gate: a demotion may only be decided on a fetch that actually REACHED the

--- begin insert ---
// A VERDICT STATES ITS OWN SCOPE (v0.31.7). Claim-coverage discipline, applied to
// the demotion rather than to the alert: the spec watches ONE custody wallet by
// choice — an irregular co-emitter would false-demote every quiet month — but the
// CLAIM is about the token. So the opposite failure is now live: ENA's 2026-09-10
// DEMOTE may be a wallet MIGRATION rather than a stopped schedule, and the watch
// cannot tell the difference. Until this line existed, that caveat lived only in the
// operator's head. Pure, so the wording is fixture-checkable.
export function demoteScope(t) {
  const fam = Array.isArray(t?.cadence?.wallets) ? t.cadence.wallets.length : 0;
  const unwatched = Array.isArray(t?.alsoObserve) ? t.alsoObserve.length : 0;
  const sym = t?.sym ?? '?';
  if (fam) {
    return `Scope: FAMILY spec — all ${fam} listed wallets were read${unwatched ? `, and ${unwatched} irregular co-emitter${unwatched === 1 ? ' is' : 's are'} deliberately outside the band` : ''}. This says the family total failed, not that one address went quiet.`;
  }
  return `Scope: SINGLE-WALLET spec — one custody wallet was read${unwatched ? `, and ${unwatched} known co-emitter${unwatched === 1 ? ' is' : 's are'} deliberately UNWATCHED (an irregular emitter would false-demote every quiet month)` : ''}. This verdict CANNOT distinguish a stopped schedule from a migration to another wallet — run node detect-cadence.js ${sym} before treating it as stopped.`;
}

--- end insert ---

